# ProbeIQ backend configuration
# All variables are optional; defaults are shown.

# Directory containing curriculum.json and candidates.json (relative to backend/).
PROBEIQ_DATA_DIR=app/data

# Runtime environment: development | production
PROBEIQ_ENVIRONMENT=development

# CORS: comma-separated allowed browser origins.
# Development default (used when unset):
#   http://localhost:5173,http://127.0.0.1:5173
# In production, set this to the deployed frontend origin(s), e.g.:
#   PROBEIQ_CORS_ALLOWED_ORIGINS=https://app.example.com
# Never use "*". Credentials are enabled (the API authenticates via an
# HTTP-only session cookie), so origins must be explicit.
# An empty value disables the CORS middleware entirely.
PROBEIQ_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication persistence (SQLite via SQLAlchemy). When unset, a probeiq.db
# file is created under the data directory (app/data/). PROBEIQ_DATABASE_URL
# must never be committed; it can point anywhere the server can write.
PROBEIQ_DATABASE_URL=
# HTTP-only session cookie name and lifetime.
PROBEIQ_AUTH_COOKIE_NAME=probeiq_session
PROBEIQ_AUTH_SESSION_TTL_DAYS=14

# Adaptive interview engine constants.
# Minimum questions and distinct curriculum days before the interview may complete.
PROBEIQ_MIN_QUESTIONS=8
PROBEIQ_MIN_COVERED_DAYS=4
# Maximum questions the engine will ask on a single topic before forcing a topic transition.
PROBEIQ_MAX_QUESTIONS_PER_TOPIC=3
# Hard cap on total questions before the engine is forced to stop (safety valve).
PROBEIQ_HARD_MAX_QUESTIONS=16

# Optional LLM integration (any OpenAI-compatible endpoint, e.g. NVIDIA NIM).
# The deterministic ProbeIQ controller still decides WHAT to probe; the LLM only
# decides HOW to phrase the question and how to judge an answer.
# When disabled (default), the template question generator and heuristic
# evaluator are used so the service runs fully offline.
PROBEIQ_LLM_ENABLED=false
# Per-call generation caps ALWAYS override the per-model max_tokens below: the
# question generator is capped at 1024 completion tokens and the answer evaluator
# / feedback writer at 2048 (see app.api.dependencies). These caps bound output
# length (and NVIDIA reasoning_budget) so a single turn never burns unbounded
# tokens -- the primary latency control. `max_tokens` here only sets the client
# default for direct invocations.
# Multi-model roster (JSON list, single line). The FIRST entry is the primary
# model; the rest are automatic fallbacks -- if an LLM call fails, the engine
# retries with the next entry. Each entry supports provider (nvidia | openai |
# openai-compatible), model, api_key, base_url, temperature, top_p, seed,
# max_tokens (completion budget), max_retries, reasoning_budget and
# enable_thinking (NVIDIA reasoning models). When this is empty/omitted, the
# single-model PROBEIQ_LLM_MODEL / PROBEIQ_LLM_API_KEY settings below are used.
# Never commit a real key -- the roster lives in the git-ignored backend/.env.
# Example (placeholders only): order fast, healthy models first (small MoE
# "nano" / "oss-20b" / "m3" answer a real interview prompt in ~5-11s), keep the
# strong but slow 550B reasoning model as the last fallback, and cap each
# reasoning_budget so no model can think for minutes.
# PROBEIQ_LLM_MODELS=[{"provider":"nvidia","model":"nvidia/nemotron-3-nano-30b-a3b","api_key":"nvapi-xxxx","temperature":0,"top_p":0.95,"max_tokens":16384,"seed":42,"reasoning_budget":16384},{"provider":"nvidia","model":"openai/gpt-oss-20b","api_key":"nvapi-yyyy","temperature":0,"top_p":0.95,"max_tokens":16384,"seed":42},{"provider":"nvidia","model":"minimaxai/minimax-m3","api_key":"nvapi-zzzz","temperature":1,"top_p":0.95,"max_tokens":16384},{"provider":"nvidia","model":"stepfun-ai/step-3.7-flash","api_key":"nvapi-wwww","temperature":0,"top_p":0.95,"max_tokens":16384,"seed":42},{"provider":"nvidia","model":"google/gemma-4-31b-it","api_key":"nvapi-vvvv","temperature":1,"top_p":0.95,"max_tokens":16384},{"provider":"nvidia","model":"nvidia/nemotron-3-ultra-550b-a55b","api_key":"nvapi-uuuu","temperature":1,"top_p":0.95,"max_tokens":16384,"reasoning_budget":16384,"enable_thinking":true},{"provider":"nvidia","model":"z-ai/glm-5.2","api_key":"nvapi-tttt","temperature":1,"top_p":0.95,"max_tokens":16384}]
# Chat model provider: nvidia | openai | openai-compatible.
#   nvidia            -> ChatNVIDIA (langchain-nvidia-ai-endpoints) for
#                        NVIDIA-hosted models via https://integrate.api.nvidia.com/v1
#                        (verified build.nvidia.com endpoint; applied automatically
#                        when PROBEIQ_LLM_BASE_URL is empty).
#   openai            -> OpenAI API (base URL optional).
#   openai-compatible -> any other OpenAI-compatible endpoint; base URL required.
PROBEIQ_LLM_PROVIDER=nvidia
# Example for NVIDIA-hosted GLM 5.2 (verified identifier on build.nvidia.com):
PROBEIQ_LLM_MODEL=z-ai/glm-5.2
# Empty by default; the nvidia provider applies the verified NVIDIA base URL.
# Override for self-hosted NIM or a proxy, e.g.:
# PROBEIQ_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PROBEIQ_LLM_BASE_URL=
# Never commit a real key. Copy backend/.env.example to backend/.env and put the
# key there (backend/.env is git-ignored).
PROBEIQ_LLM_API_KEY=
PROBEIQ_LLM_TEMPERATURE=0
# Sampling / generation knobs (GLM 5.2 example values). `max_tokens` is the
# client default; per-agent completion caps (1024 question / 2048 eval+feedback)
# override it at invoke time, so keep it small (e.g. 2048) to match reality.
PROBEIQ_LLM_TOP_P=1.0
PROBEIQ_LLM_MAX_TOKENS=2048
PROBEIQ_LLM_SEED=42
# Bounded retry count for transient LLM failures (OpenAI-compatible providers;
# ChatNVIDIA handles retries internally).
PROBEIQ_LLM_MAX_RETRIES=2
# Per-request transport timeout (seconds) applied to every LLM chat client.
# 60 (the code default) preserves the LangChain provider default. Measured on
# real interview prompts (2026-08-09): fast primaries answer in ~5-11s while the
# strong 550B fallback takes ~47s under load, so a 30s cap can cut off healthy
# responses. 60 bounds a pathological/congested model (treated as a failure, so
# the next roster entry is tried) without clipping legitimate latency.
PROBEIQ_LLM_TIMEOUT_SECONDS=60
